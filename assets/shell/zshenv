# AlexTerminal: loaded through ZDOTDIR injection. Restores the user's ZDOTDIR,
# sources their .zshenv and installs shell integration for interactive shells.
if [[ -n "${ALEXTERM_ORIG_ZDOTDIR+x}" ]]; then
  ZDOTDIR="$ALEXTERM_ORIG_ZDOTDIR"
  unset ALEXTERM_ORIG_ZDOTDIR
else
  unset ZDOTDIR
fi
if [[ -f "${ZDOTDIR:-$HOME}/.zshenv" ]]; then
  source "${ZDOTDIR:-$HOME}/.zshenv"
fi
if [[ -o interactive && -n "$ALEXTERM_INTEGRATION_DIR" ]]; then
  source "$ALEXTERM_INTEGRATION_DIR/at.zsh"
fi
